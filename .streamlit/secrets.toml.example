# ============================================================
# Modèle de secrets pour Streamlit Community Cloud
# ============================================================
# 1. Dans l'interface Streamlit Cloud : App > Settings > Secrets
# 2. Coller le contenu ci-dessous avec tes vraies valeurs
# NE JAMAIS committer secrets.toml avec les vraies valeurs !

DATABASE_URL      = "postgresql://postgres:motdepasse@db.xxx.supabase.co:5432/postgres"
GROQ_API_KEY      = "gsk_..."
FRED_API_KEY      = "..."

# Google OAuth (optionnel — laisser vide si non configuré)
GOOGLE_CLIENT_ID     = ""
GOOGLE_CLIENT_SECRET = ""
APP_URL              = "https://ton-app.streamlit.app"
SECRET_KEY           = "genere_avec: python -c \"import secrets; print(secrets.token_hex(32))\""
